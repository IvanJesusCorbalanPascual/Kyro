<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:fontFamily="@font/poppins"
        android:text="@string/kyro_ai_titulo"
        android:textColor="@color/texto_principal"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivLogoKyro"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        android:src="@drawable/logo_kyro_no_bg"
        android:contentDescription="@string/kyro_ai_desc_logo"
        app:layout_constraintBottom_toBottomOf="@+id/tvHeaderTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvHeaderTitle" />

    <TextView
        android:id="@+id/tvHeaderSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppins"
        android:text="@string/kyro_ai_subtitulo"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHeaderTitle" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHeaderSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:theme="@style/InputKyroTheme"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="@color/select_input_border"
                app:hintTextColor="@color/b500"
                android:textColorHint="@color/texto_secundario"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etInputKyro"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:fontFamily="@font/poppins"
                    android:gravity="top|start"
                    android:hint="@string/kyro_ai_hint_input"
                    android:inputType="textMultiLine"
                    android:textColor="@color/texto_principal"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kyro_ai_label_acciones"
                android:fontFamily="@font/poppins"
                android:textColor="@color/texto_principal"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupAcciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipResumir"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kyro_ai_chip_resumir"
                    android:checked="true"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/text_chip_state_list"
                    app:chipBackgroundColor="@color/bg_chip_state_list"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipExplicar"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kyro_ai_chip_explicar"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/text_chip_state_list"
                    app:chipBackgroundColor="@color/bg_chip_state_list"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEsquema"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kyro_ai_chip_esquema"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/text_chip_state_list"
                    app:chipBackgroundColor="@color/bg_chip_state_list"/>
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProcesarIA"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/poppins"
                android:text="@string/kyro_ai_btn_consultar"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="@color/bg_card_ia"
                app:cornerRadius="12dp" />

            <TextView
                android:id="@+id/tvLabelResultado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kyro_ai_label_resultado"
                android:fontFamily="@font/poppins"
                android:textColor="@color/texto_principal"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/tarjeta_fondo"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvResultadoIA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/texto_principal"
                    android:text="..."
                    android:padding="16dp"
                    android:lineSpacingExtra="4dp"/>
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/progressBarAI"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/bg_card_ia"
                android:visibility="gone"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/tarjeta_fondo"
        app:elevation="8dp"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:itemIconTint="@color/nav_item_colors"
        app:itemTextColor="@color/nav_item_colors"/>

</androidx.constraintlayout.widget.ConstraintLayout>