<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pantalla_asignatura"
    android:padding="24dp">

    <ImageButton
        android:id="@+id/btnCloseQuiz"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_cross"
        app:tint="@color/texto_principal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="@string/btn_cancelar"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tvQuizTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins"
        android:text="@string/quiz_titulo"
        android:textColor="@color/texto_principal"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btnCloseQuiz"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnCloseQuiz" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btnComprobar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCloseQuiz">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvContador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                tools:text="Pregunta 1 de 5"
                android:textColor="@color/texto_principal"
                android:textSize="14sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBarQuiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:progress="20"
                app:indicatorColor="#00A8E8"
                app:trackColor="@color/tarjeta_fondo"
                app:trackCornerRadius="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/tarjeta_fondo"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvPregunta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:padding="24dp"
                    android:text="@string/quiz_cargando"
                    android:textColor="@color/texto_principal"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_blanco_redondeado"
                android:backgroundTint="@color/tarjeta_fondo"
                android:fontFamily="@font/poppins"
                android:padding="12dp"
                android:text="@string/quiz_explicacion_default"
                android:textColor="#FF5252"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/layoutOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/layoutOpcionA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_blanco_redondeado"
                    android:backgroundTint="@color/selector_quiz_tint"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:animateLayoutChanges="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="A)"
                        android:textColor="@color/b500"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:duplicateParentState="true"/>

                    <TextView
                        android:id="@+id/tvOpcionA"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:fontFamily="@font/poppins"
                        android:text="@string/quiz_opcion_a"
                        android:textColor="@color/b500"
                        android:textSize="16sp"
                        android:duplicateParentState="true"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutOpcionB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_blanco_redondeado"
                    android:backgroundTint="@color/selector_quiz_tint"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:animateLayoutChanges="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="B)"
                        android:textColor="@color/b500"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:duplicateParentState="true"/>

                    <TextView
                        android:id="@+id/tvOpcionB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:fontFamily="@font/poppins"
                        android:text="@string/quiz_opcion_b"
                        android:textColor="@color/b500"
                        android:textSize="16sp"
                        android:duplicateParentState="true"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutOpcionC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_blanco_redondeado"
                    android:backgroundTint="@color/selector_quiz_tint"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:animateLayoutChanges="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="C)"
                        android:textColor="@color/b500"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:duplicateParentState="true"/>

                    <TextView
                        android:id="@+id/tvOpcionC"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:fontFamily="@font/poppins"
                        android:text="@string/quiz_opcion_c"
                        android:textColor="@color/b500"
                        android:textSize="16sp"
                        android:duplicateParentState="true"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutOpcionD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_blanco_redondeado"
                    android:backgroundTint="@color/selector_quiz_tint"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:animateLayoutChanges="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="D)"
                        android:textColor="@color/b500"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:duplicateParentState="true"/>

                    <TextView
                        android:id="@+id/tvOpcionD"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:fontFamily="@font/poppins"
                        android:text="@string/quiz_opcion_d"
                        android:textColor="@color/b500"
                        android:textSize="16sp"
                        android:duplicateParentState="true"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnComprobar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:fontFamily="@font/poppins"
        android:text="@string/quiz_btn_comprobar"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#00A8E8"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>