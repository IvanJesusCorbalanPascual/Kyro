<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pantalla_asignatura"
    android:fitsSystemWindows="true"
    tools:context=".activities.EventDetailActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/tarjeta_fondo"
            android:elevation="4dp"
            app:navigationIcon="@drawable/ic_back_arrow"
            app:navigationIconTint="@color/texto_principal"
            app:title="Detalles del Evento"
            app:titleTextColor="@color/texto_principal"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Área de contenido desplazable -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card para el Título y la Fecha -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/tarjeta_fondo">
                <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="Nombre de la Asignatura"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/texto_principal"/>

                    <TextView
                android:id="@+id/tvDetailAsignatura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:textSize="16sp"
                app:drawableStartCompat="@drawable/ic_book"
                app:drawableTint="@color/texto_principal"
                tools:text="Asignatura"
                android:fontFamily="@font/poppins"
                android:textColor="@color/texto_principal"/>

                    <TextView
                android:id="@+id/tvDetailDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:textSize="16sp"
                app:drawableStartCompat="@drawable/ic_calendar"
                app:drawableTint="@color/texto_principal"
                tools:text="YYYY-MM-DD"
                android:textColor="@color/texto_principal"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card para la Descripción -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/tarjeta_fondo">
                <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/event_detail_label_desc"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_task"
                    app:drawableTint="@color/texto_principal"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/texto_principal"/>
                    <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                tools:text="Descripción detallada del evento..."
                android:fontFamily="@font/poppins"
                android:textColor="@color/texto_principal"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/tarjeta_fondo">
                <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/event_detail_label_recordatorios"
                    android:fontFamily="@font/poppins"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_notifications"
                    app:drawableTint="@color/texto_principal"
                    android:textColor="@color/texto_principal"/>
                    <TextView
                android:id="@+id/tvDetailNotif1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                tools:text="Recordatorio 1: ..."
                android:fontFamily="@font/poppins"
                android:textColor="@color/texto_principal"/>
                    <TextView
                android:id="@+id/tvDetailNotif2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Recordatorio 2: ..."
                android:fontFamily="@font/poppins"
                android:textColor="@color/texto_principal"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkAsIncomplete"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:text="@string/event_detail_btn_incompleta"
                android:textColor="@android:color/white"
                app:backgroundTint="#FFC107"
                app:cornerRadius="20dp"
                android:textSize="16sp"
                android:visibility="gone"
                app:icon="@drawable/ic_restore" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditEvent"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:padding="12dp"
                    android:text="@string/event_detail_btn_editar"
                    android:fontFamily="@font/poppins"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#0085FF"
                    app:cornerRadius="20dp"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_edit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteEvent"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:padding="12dp"
                    android:text="@string/event_detail_btn_eliminar"
                    android:fontFamily="@font/poppins"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@android:color/holo_red_dark"
                    app:cornerRadius="20dp"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_delete"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Barra de Navegación Inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tarjeta_fondo"
        app:elevation="8dp"
        app:itemIconTint="@color/nav_item_colors"
        app:itemTextColor="@color/nav_item_colors"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu"
        app:itemTextAppearanceActive="@style/BottomNavTextStyle"
        app:itemTextAppearanceInactive="@style/BottomNavTextStyle"/>

</androidx.constraintlayout.widget.ConstraintLayout>