<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp"
    android:background="@drawable/img_fondo_primal"
    android:fitsSystemWindows="true">

    <View
        android:id="@+id/viewBackgroundDeco"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.5"
        android:layout_margin="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/imgMainIllustration"
        app:layout_constraintEnd_toEndOf="@+id/imgMainIllustration"
        app:layout_constraintStart_toStartOf="@+id/imgMainIllustration"
        app:layout_constraintTop_toTopOf="@+id/imgMainIllustration" />

    <ImageView
        android:id="@+id/imgMainIllustration"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Ilustración Principal"
        android:scaleType="fitCenter"
        android:src="@drawable/portrait_kyro_no_bg"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintHeight_percent="0.45"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/primal1"
        android:textColor="#000000"
        android:textSize="34sp"
        android:fontFamily="@font/poppins"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgMainIllustration"
        app:layout_constraintBottom_toTopOf="@+id/tvSubtitulo" />

    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/primal2"
        android:textColor="#333333"
        android:textSize="19sp"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitulo" />

    <LinearLayout
        android:id="@+id/layoutDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnNext">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_dot"
            android:state_selected="true" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_dot" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_dot" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnNext"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_azul_oscuro_kyro"
        android:src="@drawable/ic_flecha_derecha"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>